---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageFrame from '../components/PageFrame.astro';
import Interests from '../components/Interests.astro';
import Icon from '../components/Icon.astro';
import { notes } from '../data/notes';
import { projects } from '../data/projects';
---

<SiteLayout>
  <PageFrame>
    <section class="hero-field" aria-labelledby="intro-title">
      <div class="introduction">
        <h1 id="intro-title">Hi, I’m <span>Emil.</span></h1>
        <div class="intro-bottom">
          <p>I’m a software engineer in Oslo. I work mostly on backend systems, and spend some of my free time playing tennis, making tools, and experimenting with graphics and simulations.</p>
          <div class="hero-socials" aria-label="Social links">
            <a class="social-button" href="https://github.com/erg0nix">
              <Icon name="github" /><span>GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </section>
    <div class="interest-strip"><Interests /></div>
    <div class="work-index">
      <section class="projects-section" id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Projects</h2>
        <ol class="project-rows">
          {projects.map(project => (
            <li>
              <a class="project-row" href={project.href}>
                <span class="row-symbol"><Icon name={project.name} /></span>
                <div class="row-heading"><h3>{project.name}</h3><span>{project.detail}</span></div>
                <p>{project.description}</p>
              </a>
            </li>
          ))}
        </ol>
      </section>
      <section class="notes-section" id="notes" aria-labelledby="notes-title">
        <h2 id="notes-title">Notes</h2>
        <ol class="note-entries">
          {notes.map(note => (
            <li class="note-entry">
              <a href={`/notes/${note.slug}/`}>
                <span class="row-symbol"><Icon name="note" /></span>
                <div class="row-heading">
                  <h3>{note.title}</h3>
                  <time datetime={note.date}>{note.label}</time>
                </div>
                <p>{note.summary}</p>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </PageFrame>
</SiteLayout>

<style>
  .introduction {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    align-content: center;
    margin: 0;
    padding: 56px 40px;
    font-size: clamp(52px, 6vw, 80px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -.055em;
  }

  h1 span { display: block; color: var(--accent); }

  .intro-bottom {
    align-content: center;
    padding: 56px 40px;
    border-left: 1px solid var(--line);
  }

  .intro-bottom p {
    max-width: 48ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .hero-socials { margin-top: 24px; }

  .social-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 10px 24px 10px 16px;
    background: var(--yellow);
    color: var(--on-yellow);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
    text-decoration: none;
    font-weight: 500;
    transition: background 160ms ease;
  }

  .social-button:focus-visible { clip-path: none; }
  .social-button:hover { background: var(--yellow-hover); }
  .social-button :global(svg) { width: 18px; height: 18px; }

  .interest-strip { border-bottom: 1px solid var(--line); }

  .projects-section,
  .notes-section {
    display: grid;
    grid-template-columns: var(--section-label) minmax(0, 1fr);
  }

  .notes-section { border-top: 1px solid var(--line); }

  h2 {
    margin: 0;
    padding: 32px 40px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
  }

  h2::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 14px;
    margin-right: 12px;
    vertical-align: -2px;
    background: var(--accent);
  }

  .project-rows,
  .note-entries {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 20px;
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .project-row,
  .note-entry a {
    display: grid;
    grid-template-columns: 18px 104px 112px minmax(0, 1fr);
    align-items: baseline;
    gap: 4px 12px;
    padding: 10px 12px;
    border-radius: 3px;
    text-decoration: none;
    transition: background 160ms ease;
  }

  .project-row:hover,
  .project-row:focus-visible,
  .note-entry a:hover,
  .note-entry a:focus-visible { background: var(--surface); }

  .row-symbol {
    display: grid;
    place-items: center;
    align-self: start;
    padding-top: 2px;
    color: var(--subtle);
  }

  .row-symbol :global(svg) { width: 18px; height: 18px; }

  .row-heading { display: contents; }

  .project-row h3,
  .note-entry h3 {
    margin: 0;
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
  }

  .row-heading span,
  .note-entry time { color: var(--subtle); }

  .project-row p,
  .note-entry p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .note-entry time { white-space: nowrap; font-variant-numeric: tabular-nums; }

  @media (max-width: 1000px) {
    .project-row, .note-entry a { grid-template-columns: 18px minmax(0, 1fr); }
    .row-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 2px 12px;
    }
    .project-row p, .note-entry p { grid-column: 2; }
  }

  @media (max-width: 760px) {
    .introduction { grid-template-columns: minmax(0, 1fr); }
    h1 { padding: 36px 24px 24px; font-size: 56px; }
    h1 span { display: inline; }
    .intro-bottom { padding: 0 24px 36px; border-left: 0; }
    .projects-section, .notes-section { grid-template-columns: minmax(0, 1fr); }
    h2 { padding: 24px 24px 12px; }
    .project-rows, .note-entries { border-left: 0; padding: 0 12px 20px; }
  }

  @media (max-width: 380px) {
    h1 { font-size: 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-button, .project-row, .note-entry a { transition: none; }
  }
</style>
