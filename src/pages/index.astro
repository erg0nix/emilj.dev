---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
import Interests from '../components/Interests.astro';
import WireframeMesh from '../components/WireframeMesh.astro';
import Icon from '../components/Icon.astro';
import { notes } from '../data/notes';
import { projects } from '../data/projects';
---

<SiteLayout>
  <section class="hero-field" aria-labelledby="intro-title">
    <WireframeMesh />
    <div class="page-width hero-content">
      <div class="hero-navigation"><Navigation /></div>
      <div class="introduction">
        <h1 id="intro-title">Hi, I’m <span>Emil.</span></h1>
        <div class="intro-bottom">
          <p>I’m a software engineer in Oslo. I work mostly on backend systems, and spend some of my free time playing tennis, making tools, and experimenting with graphics and simulations.</p>
          <div class="hero-socials" aria-label="Social links">
            <a class="social-button" href="https://github.com/erg0nix"><Icon name="github" /><span>GitHub</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="interest-strip">
    <div class="page-width">
      <Interests />
    </div>
  </div>
  <div class="work-index page-width">
    <section class="projects-section" id="projects" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      <ol class="project-rows">
        {projects.map(project => (
          <li>
            <a class="project-row" href={project.href}>
              <span class="row-symbol"><Icon name={project.name} /></span>
              <div class="row-name"><h3>{project.name}</h3><span>{project.detail}</span></div>
              <p>{project.description}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
    <section class="notes-section" id="notes" aria-labelledby="notes-title">
      <h2 id="notes-title">Notes</h2>
      <ol class="note-entries">
        {notes.map(note => (
          <li class="note-entry">
            <a href={`/notes/${note.slug}/`}>
              <span class="row-symbol"><Icon name="note" /></span>
              <h3>{note.title}</h3>
              <time datetime={note.date}>{note.label}</time>
              <p>{note.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</SiteLayout>

<style>
  .hero-field { position:relative; isolation:isolate; display:grid; min-height:560px; overflow:hidden; }
  .hero-navigation { position:absolute; top:16px; left:0; right:0; z-index:2; pointer-events:auto; }
  .hero-content { position:relative; z-index:1; display:grid; grid-template-columns:minmax(0,1fr); align-content:center; padding-block:130px 90px; }
  .introduction { position:relative; width:fit-content; max-width:100%; }
  h1 { font-size:clamp(56px,6.8vw,98px); line-height:.98; font-weight:400; letter-spacing:-.065em; margin:0; }
  h1 span { color:var(--accent); }
  .intro-bottom { margin-top:32px; }
  .intro-bottom p { max-width:43ch; margin:0; color:var(--muted); font-size:14px; line-height:1.8; }
  .hero-socials { display:flex; flex-wrap:wrap; gap:12px; margin-top:24px; }
  .social-button { position:relative; display:inline-flex; align-items:center; gap:12px; min-height:44px; padding:9px 22px 9px 16px; color:#17180e; background:#f1db4b; clip-path:polygon(0 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%); text-decoration:none; font-family:var(--mono); transition:background 160ms ease; }
  .social-button:focus-visible { clip-path:none; }
  .social-button :global(svg) { width:18px; height:18px; }
  .social-button:hover { background:#f9e878; }
  .interest-strip { border-block:1px solid var(--line); }
  .interest-strip .page-width { display:flex; align-items:center; min-height:56px; }

  .work-index { padding-bottom:64px; }
  .projects-section, .notes-section { display:grid; grid-template-columns:144px minmax(0,1fr); column-gap:40px; padding-block:32px; }
  .notes-section { border-top:1px solid var(--line); }
  h2 { display:flex; align-items:center; gap:12px; align-self:start; margin:12px 0 0; font:400 14px/1.6 var(--mono); color:var(--text); }
  h2::before { content:''; width:5px; height:5px; flex:none; border:1px solid var(--accent); }
  .project-rows { display:grid; gap:2px; list-style:none; padding:0; margin:0 -12px; max-width:864px; }
  .project-row, .note-entry { --item-highlight:var(--surface); background:transparent; border-radius:4px; transition:background 160ms ease; }
  :global(:root[data-theme='light']) .project-row, :global(:root[data-theme='light']) .note-entry { --item-highlight:var(--raised); }
  .project-row:hover, .project-row:focus-visible, .note-entry:hover, .note-entry:focus-within { background:var(--item-highlight); }
  .project-row { display:grid; grid-template-columns:18px max-content minmax(0,1fr); align-items:baseline; gap:4px 14px; min-height:44px; padding:12px; color:var(--text); text-decoration:none; }
  .project-row:focus-visible { outline-offset:3px; }
  .row-symbol { display:grid; place-items:center; align-self:start; padding-top:2px; color:var(--muted); }
  .row-symbol :global(svg) { width:18px; height:18px; }
  .row-name { display:flex; align-items:baseline; gap:14px; }
  .row-name h3 { margin:0; color:var(--accent); font:400 14px/1.6 var(--mono); }
  .row-name span { color:var(--subtle); white-space:nowrap; font-size:14px; }
  .project-row p { margin:0; color:var(--muted); line-height:1.6; }
  .note-entries { display:grid; gap:2px; list-style:none; padding:0; margin:0 -12px; max-width:720px; }
  .note-entry h3 { margin:0; font:400 14px/1.6 var(--mono); }
  .note-entry a { display:grid; grid-template-columns:18px max-content max-content minmax(0,1fr); align-items:baseline; gap:4px 14px; padding:12px; border-radius:inherit; color:var(--accent); text-decoration:none; }
  .note-entry time { color:var(--subtle); white-space:nowrap; font-variant-numeric:tabular-nums; }
  .note-entry p { margin:0; color:var(--muted); }

  @media (min-width:1600px) {
    .hero-field { min-height:600px; }
  }
  @media (max-width:1100px) {
    .projects-section, .notes-section { grid-template-columns:110px minmax(0,1fr); column-gap:24px; }
    .project-row { grid-template-columns:18px minmax(0,1fr); }
    .row-name, .project-row p { grid-column:2; }
    .row-symbol { grid-column:1; grid-row:1; }
  }
  @media (max-width:760px) {
    .hero-field { min-height:0; }
    .hero-navigation { top:8px; }
    .hero-content { padding-block:130px 64px; }
    h1 { font-size:clamp(46px,8vw,64px); }
    .intro-bottom { margin-top:25px; }
    .work-index { padding-bottom:32px; }
    .projects-section, .notes-section { grid-template-columns:minmax(0,1fr); gap:16px; padding-block:24px; }
    h2 { margin:0; }
    .project-row { gap:4px 12px; }
    .row-name { flex-wrap:wrap; gap:4px 12px; }
    .note-entry a { column-gap:12px; }
  }
  @media (max-width:560px) {
    .intro-bottom p { max-width:34ch; }
    .hero-socials { margin-top:18px; }
    .note-entry a { grid-template-columns:18px max-content minmax(0,1fr); }
    .note-entry p { grid-column:2 / -1; grid-row:2; }
    .note-entry time { grid-column:3; grid-row:1; }
  }
  @media (prefers-reduced-motion:reduce) {
    .social-button, .project-row, .note-entry { transition:none; }
  }
</style>
