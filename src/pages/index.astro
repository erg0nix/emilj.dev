---
import SiteLayout from '../layouts/SiteLayout.astro';
import SeasonalArt from '../components/SeasonalArt.astro';
import Icon from '../components/Icon.astro';
import { notes } from '../data/notes';
import { projects } from '../data/projects';
---

<SiteLayout>
  <section class="hero-field" aria-labelledby="intro-title">
    <SeasonalArt />
    <div class="page-width hero-content">
      <h1 id="intro-title">Software engineer.<br /><span>Curious by default.</span></h1>
      <div class="intro-bottom">
        <p>I build backend systems, agents, and tools.<br />A few things I’m making, and what I’m learning<br class="desktop-break" /> along the way.</p>
        <div class="hero-socials" aria-label="Social links">
          <a class="social-button" href="https://github.com/erg0nix"><Icon name="github" /><span>GitHub</span></a>
        </div>
      </div>
    </div>
    <div class="hero-edge" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </section>
  <div class="interest-strip">
    <div class="page-width">
      <p>Local-first software <i aria-hidden="true"></i> Agent tooling <i aria-hidden="true"></i> Graphics &amp; simulation</p>
    </div>
  </div>
  <section class="projects-section page-width" id="projects" aria-labelledby="projects-title">
    <div class="projects-heading"><h2 id="projects-title">Projects</h2></div>
    <ol class="project-rows">
      {projects.map(project => (
        <li>
          <a class="project-row" href={project.href}>
            <span class="row-symbol"><Icon name={project.name} /></span>
            <div class="row-name"><h3>{project.name}</h3><span>{project.detail}</span></div>
            <p>{project.description}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
  <section class="notes-section page-width" id="notes" aria-labelledby="notes-title">
    <h2 id="notes-title">Notes</h2>
    <ol class="note-entries">
      {notes.map(note => (
        <li class="note-entry">
          <a href={`/notes/${note.slug}/`}>
            <span class="row-symbol"><Icon name="note" /></span>
            <h3>{note.title}</h3>
            <time datetime={note.date}>{note.label}</time>
            <p>{note.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</SiteLayout>

<style>
  .hero-field { position:relative; isolation:isolate; min-height:590px; overflow:hidden; border-bottom:1px solid var(--line); }
  .hero-content { position:relative; z-index:1; padding-top:79px; padding-bottom:74px; pointer-events:none; }
  .hero-content a { pointer-events:auto; }
  h1 { font-size:clamp(44px,5.8vw,80px); line-height:1.04; font-weight:500; letter-spacing:-3.9px; margin:0; }
  h1 span { color:var(--muted); }
  .intro-bottom { margin-top:31px; }
  .intro-bottom p { margin:0; color:var(--muted); font-size:15px; line-height:1.75; }
  .hero-socials { display:flex; flex-wrap:wrap; gap:12px; margin-top:25px; }
  .social-button { display:inline-flex; align-items:center; gap:10px; min-height:44px; padding:9px 16px; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--text); text-decoration:none; }
  .social-button :global(svg) { width:20px; height:20px; }
  .social-button:hover { background:var(--raised); }
  .hero-edge { position:absolute; inset:auto 0 0; height:10px; display:flex; justify-content:space-between; padding-inline:8.33%; pointer-events:none; }
  .hero-edge span { height:10px; border-left:1px solid var(--line); }
  .interest-strip { border-bottom:1px solid var(--fine); }
  .interest-strip .page-width { display:flex; align-items:center; justify-content:flex-start; min-height:60px; }
  .interest-strip p { display:flex; gap:24px; align-items:center; justify-content:flex-start; text-align:left; margin:0; color:var(--muted); }
  .interest-strip i { width:3px; height:3px; background:var(--subtle); }

  .projects-section { padding-block:48px 40px; }
  .projects-heading { margin-bottom:12px; }
  h2 { margin:0; font-size:22px; font-weight:500; letter-spacing:-.5px; line-height:1.3; }
  .project-rows { display:grid; gap:4px; list-style:none; padding:0; margin:0 -12px; max-width:864px; }
  .project-row, .note-entry { --item-highlight:var(--surface); background:transparent; border-radius:8px; }
  :global(:root[data-theme='light']) .project-row, :global(:root[data-theme='light']) .note-entry { --item-highlight:var(--raised); }
  .project-row:hover, .project-row:focus-visible, .note-entry:hover, .note-entry:focus-within { background:var(--item-highlight); }
  .project-row { display:grid; grid-template-columns:20px max-content minmax(0,1fr); align-items:baseline; gap:4px 16px; min-height:44px; padding:12px; color:var(--text); text-decoration:none; }
  .project-row:focus-visible { outline-offset:3px; }
  .row-symbol { display:grid; place-items:center; align-self:start; padding-top:2px; color:var(--muted); }
  .row-symbol :global(svg) { width:20px; height:20px; }
  .row-name { display:flex; align-items:baseline; gap:16px; }
  .row-name h3 { margin:0; color:var(--accent); font-size:inherit; font-weight:500; line-height:1.3; letter-spacing:-.3px; }
  .row-name span { color:var(--subtle); white-space:nowrap; }
  .project-row p { margin:0; color:var(--muted); line-height:1.6; }
  .notes-section { padding:0 0 80px; }
  .note-entries { display:grid; gap:4px; list-style:none; padding:0; margin:12px -12px 0; width:calc(100% + 24px); max-width:664px; }
  .note-entry h3 { margin:0; font-size:inherit; font-weight:400; line-height:1.4; }
  .note-entry a { display:grid; grid-template-columns:20px max-content max-content minmax(0,1fr); align-items:baseline; gap:4px 16px; padding:12px; border-radius:inherit; color:var(--accent); text-decoration:none; }
  .note-entry time { color:var(--subtle); white-space:nowrap; font-variant-numeric:tabular-nums; }
  .note-entry p { margin:0; color:var(--muted); }

  @media (min-width:1600px) {
    .hero-field { min-height:640px; }
    .hero-content { padding-top:100px; }
    h1 { font-size:86px; }
  }
  @media (max-width:1100px) {
    h1 { letter-spacing:-2.7px; }
    .hero-content { padding-top:70px; }
  }
  @media (max-width:760px) {
    .hero-field { min-height:620px; }
    .hero-content { padding-top:56px; padding-bottom:0; }
    h1 { font-size:clamp(40px,7.5vw,57px); letter-spacing:-2.3px; }
    .intro-bottom { margin-top:25px; }
    .intro-bottom p { font-size:14px; }
    .interest-strip .page-width { padding-block:15px; }
    .interest-strip p { gap:14px; }
    .notes-section { padding-bottom:48px; }
    .projects-section { padding-block:32px; }
    .project-row { grid-template-columns:20px minmax(0,1fr); gap:4px 12px; }
    .row-symbol { grid-column:1; grid-row:1; }
    .row-name { grid-column:2; flex-wrap:wrap; gap:4px 12px; }
    .project-row p { grid-column:2; }
    .note-entry a { column-gap:12px; }
  }
  @media (max-width:560px) {
    .hero-field { min-height:650px; }
    .hero-content { padding-top:43px; }
    h1 { font-size:clamp(33px,8.7vw,48px); letter-spacing:-1.6px; }
    .desktop-break { display:none; }
    .intro-bottom p { max-width:34ch; }
    .hero-socials { margin-top:18px; }
    .interest-strip p { gap:10px; flex-wrap:wrap; }
    .note-entry a { grid-template-columns:20px max-content minmax(0,1fr); }
    .note-entry p { grid-column:2 / -1; grid-row:2; }
    .note-entry time { grid-column:3; grid-row:1; }
  }
</style>
