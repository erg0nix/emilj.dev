---
import Icon from './Icon.astro';

const seasonOptions = [
  ['auto', 'Automatic'],
  ['winter', 'Winter'],
  ['spring', 'Spring'],
  ['summer', 'Summer'],
  ['autumn', 'Autumn'],
];
---

<div class="navigation">
  <nav aria-label="Main navigation">
    <a class="home-link" href="/" aria-label="Home" title="Home"><Icon name="home" /></a>
    <a href="/#projects">Projects</a>
    <a href="/#notes">Notes</a>
  </nav>
  <details class="season-picker" hidden>
    <summary aria-label="Season: Automatic" title="Season: Automatic"><Icon name="auto" /></summary>
    <div class="season-options" role="group" aria-label="Season">
      {seasonOptions.map(([value, label]) => (
        <button type="button" data-season-choice={value} aria-label={label} title={label} aria-pressed={value === 'auto'}>
          <Icon name={value} />
        </button>
      ))}
    </div>
  </details>
  <button id="theme" class="theme-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="true" hidden>
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
    </svg>
  </button>
</div>

<style>
  .navigation {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: 64px;
    border-bottom: 1px solid var(--line);
  }

  nav {
    display: flex;
    margin-right: auto;
  }

  nav a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 24px;
    border-right: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: .02em;
  }

  nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease;
  }

  nav a:hover::after,
  nav a:focus-visible::after { transform: scaleX(1); }
  nav a:hover, nav a:focus-visible { color: var(--text); }
  nav .home-link { width: 64px; padding: 12px; }
  .home-link :global(svg) { width: 20px; height: 20px; }

  .theme-toggle,
  .season-picker summary {
    display: grid;
    place-items: center;
    width: 64px;
    height: 100%;
    min-height: 44px;
    padding: 12px;
    border-left: 1px solid var(--line);
    color: var(--muted);
  }

  .theme-toggle { flex: none; height: auto; }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-toggle:hover { color: var(--accent); background: var(--surface); }
  .theme-toggle[aria-checked='true'] .moon,
  .theme-toggle[aria-checked='false'] .sun { display: none; }

  .season-picker { position: relative; flex: none; }
  .season-picker summary { list-style: none; cursor: pointer; }
  .season-picker summary::-webkit-details-marker { display: none; }
  .season-picker :global(svg) { width: 20px; height: 20px; }

  .season-options {
    position: absolute;
    z-index: 5;
    right: -64px;
    top: calc(100% + 8px);
    display: flex;
    gap: 2px;
    padding: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .season-options button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 12px;
    color: var(--muted);
  }

  .season-picker summary:hover,
  .season-options button:hover { background: var(--raised); color: var(--text); }
  .season-picker[open] summary,
  .season-options button[aria-pressed='true'] { color: var(--accent); background: var(--raised); }

  @media (max-width: 760px) {
    .navigation { min-height: 56px; }
    nav a { padding-inline: 12px; }
    nav .home-link, .theme-toggle, .season-picker summary { width: 44px; }
    .season-options { right: -44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after { transition: none; }
  }

  @media (max-width: 380px) {
    nav a { padding-inline: 8px; }
  }
</style>
