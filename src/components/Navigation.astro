---
import Icon from './Icon.astro';

const seasonOptions = [
  ['auto', 'Automatic'],
  ['winter', 'Winter'],
  ['spring', 'Spring'],
  ['summer', 'Summer'],
  ['autumn', 'Autumn'],
];
---

<div class="navigation">
  <nav aria-label="Main navigation">
    <a class="home-link" href="/" aria-label="Home" title="Home"><Icon name="home" /></a>
    <a href="/#projects">Projects</a>
    <a href="/#notes">Notes</a>
  </nav>
  <details class="season-picker" hidden>
    <summary aria-label="Season: Automatic" title="Season: Automatic"><Icon name="auto" /></summary>
    <div class="season-options" role="group" aria-label="Season">
      {seasonOptions.map(([value, label]) => (
        <button type="button" data-season-choice={value} aria-label={label} title={label} aria-pressed={value === 'auto'}>
          <Icon name={value} />
        </button>
      ))}
    </div>
  </details>
  <button id="theme" class="theme-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="true" hidden>
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
    </svg>
  </button>
</div>

<style>
  .navigation { position:relative; display:flex; align-items:center; gap:4px; width:100%; min-height:64px; border-bottom:1px solid var(--line); font-family:var(--mono); }
  .navigation::after { content:''; position:absolute; bottom:-1px; left:0; width:44px; height:3px; background:var(--accent); }
  nav { display:flex; align-items:center; gap:20px; margin-right:auto; }
  nav a { position:relative; display:flex; align-items:center; justify-content:center; min-height:44px; padding:0 4px; color:var(--muted); text-decoration:none; font-size:14px; font-weight:400; text-transform:uppercase; letter-spacing:.04em; }
  nav a::after { content:''; position:absolute; inset:auto 4px 4px; height:1px; background:var(--accent); transform:scaleX(0); transform-origin:left; transition:transform 160ms ease; }
  nav a:hover::after, nav a:focus-visible::after { transform:scaleX(1); }
  nav a:hover, nav a:focus-visible { color:var(--text); }
  nav .home-link { width:44px; flex:none; padding:12px; }
  .home-link :global(svg) { width:20px; height:20px; }
  .theme-toggle { width:44px; height:44px; flex:none; border-radius:3px; padding:13px; display:grid; place-items:center; color:var(--muted); }
  .theme-toggle svg { width:18px; height:18px; }
  .theme-toggle:hover { color:var(--accent); background:var(--surface); }
  .theme-toggle[aria-checked='true'] .moon, .theme-toggle[aria-checked='false'] .sun { display:none; }
  .season-picker { position:relative; flex:none; }
  .season-picker summary, .season-options button { display:grid; place-items:center; width:44px; height:44px; padding:12px; border-radius:3px; cursor:pointer; color:var(--muted); }
  .season-picker summary { list-style:none; }
  .season-picker summary::-webkit-details-marker { display:none; }
  .season-picker :global(svg) { width:20px; height:20px; }
  .season-picker summary:hover, .season-options button:hover { background:var(--raised); color:var(--text); }
  .season-picker[open] summary, .season-options button[aria-pressed='true'] { color:var(--accent); background:var(--raised); }
  .season-options { position:absolute; z-index:5; right:-48px; top:calc(100% + 10px); display:flex; gap:2px; padding:6px; border:1px solid var(--line); border-radius:3px; background:var(--surface); }

  @media (max-width:560px) {
    .navigation { gap:2px; }
    nav { gap:12px; }
    nav a { padding-inline:0; }
  }
  @media (prefers-reduced-motion:reduce) { nav a::after { transition:none; } }
</style>
