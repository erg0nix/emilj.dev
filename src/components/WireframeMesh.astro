---
const rows = 18;
const columns = 12;
const points = Array.from({ length: rows + 1 }, (_, row) => {
  const v = row / rows;
  return Array.from({ length: columns + 1 }, (_, column) => {
    const u = column / columns;
    const x = 410 - 240 * Math.sin(Math.PI * v) + 270 * v * v
      + (400 + 60 * Math.cos(2 * Math.PI * v)) * u;
    const y = -80 + 660 * v + 90 * Math.sin(Math.PI * u) * Math.sin(Math.PI * v);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
});
const crossSections = points.map(row => row.join(' '));
const lengthwise = Array.from({ length: columns + 1 }, (_, column) =>
  points.map(row => row[column]).join(' ')
);
const diagonals = points.slice(0, -1).flatMap((row, rowIndex) =>
  row.slice(0, -1).flatMap((point, column) =>
    (rowIndex + column) % 3 === 0 ? [`${point} ${points[rowIndex + 1][column + 1]}`] : []
  )
);
---

<svg class="wireframe-mesh" viewBox="0 0 900 560" fill="none" aria-hidden="true" focusable="false">
  <g class="diagonals">
    {diagonals.map(line => <polyline points={line} />)}
  </g>
  <g class="surface">
    {crossSections.map(line => <polyline points={line} />)}
    {lengthwise.slice(1).map(line => <polyline points={line} />)}
  </g>
  <g class="seams">
    <polyline points={lengthwise[0]} />
    <polyline points={lengthwise[4]} />
    <polyline points={crossSections[7]} />
    <polyline points={crossSections[13]} />
  </g>
</svg>

<style>
  .wireframe-mesh { position:absolute; top:80px; right:-100px; width:min(76vw,1100px); height:calc(100% - 80px); overflow:hidden; pointer-events:none; }
  polyline { vector-effect:non-scaling-stroke; stroke-linejoin:round; }
  .surface { stroke:var(--subtle); stroke-width:.75; opacity:.43; }
  .diagonals { stroke:var(--subtle); stroke-width:.65; opacity:.2; }
  .seams { stroke:var(--accent); stroke-width:1; opacity:.8; }
  @media (max-width:1100px) {
    .wireframe-mesh { right:-180px; width:850px; }
  }
  @media (max-width:760px) {
    .wireframe-mesh { top:80px; right:-300px; width:600px; height:360px; opacity:.3; }
  }
</style>
