---
const interests = ['Local-first software', 'Backend systems', 'Tennis', 'Graphics & simulation'];
---

<ul class="interests" aria-label="Interests">
  {interests.map(interest => <li>{interest}</li>)}
</ul>

<style>
  .interests {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    min-height: 68px;
    padding: 16px 24px;
    color: var(--muted);
  }

  li + li { border-left: 1px solid var(--line); }

  @media (max-width: 760px) {
    .interests { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    li { min-height: 64px; padding: 16px 24px; }
    li:nth-child(3) { border-left: 0; }
    li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
