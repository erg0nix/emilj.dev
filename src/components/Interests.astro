---
const interests = ['Local-first software', 'Backend systems', 'Tennis', 'Graphics & simulation'];
---

<ul class="interests" aria-label="Interests">
  {interests.map(interest => <li>{interest}</li>)}
</ul>

<style>
  .interests { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px 24px; list-style:none; padding:22px 0; margin:0; font:14px/1.6 var(--mono); }
  li { display:flex; align-items:baseline; gap:10px; color:var(--muted); }
  li::before { content:'+'; color:var(--accent); }
  @media (max-width:1100px) {
    .interests { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 20px; }
  }
</style>
