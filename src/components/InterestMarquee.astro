---
const interests = ['Local-first software', 'Backend systems', 'Game development', 'Agent tooling', 'Apps', 'Tennis', 'Graphics & simulation', 'Dog training'];
---

<div class="interest-marquee" data-marquee>
  <div class="marquee-window">
    <div class="marquee-track">
      {[0, 1].map(copy => <ul class="marquee-group" aria-label={copy === 0 ? 'Interests' : undefined} aria-hidden={copy === 1 ? 'true' : undefined}>
        {[0, 1].map(repeat => interests.map(interest => <li class:list={{ repeat: repeat === 1 }} aria-hidden={repeat === 1 ? 'true' : undefined}>{interest}</li>))}
      </ul>)}
    </div>
  </div>
</div>

<script>
  const marquee = document.querySelector<HTMLElement>('[data-marquee]');
  if (marquee) {
    new IntersectionObserver(([entry]) => { marquee.dataset.offscreen = String(!entry.isIntersecting); }).observe(marquee);
    document.addEventListener('visibilitychange', () => { marquee.dataset.hidden = String(document.hidden); });
  }
</script>

<style>
  .interest-marquee { display:flex; align-items:center; min-width:0; width:100%; min-height:60px; }
  .marquee-window { overflow:hidden; min-width:0; flex:1; mask-image:linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 16px), transparent); }
  .marquee-track { display:flex; width:max-content; animation:interests-scroll 72s linear infinite; }
  .marquee-group { display:flex; flex-shrink:0; align-items:center; gap:32px; list-style:none; margin:0; padding:0 32px 0 0; }
  .marquee-group li { display:flex; align-items:center; gap:32px; white-space:nowrap; color:var(--muted); font-size:14px; }
  .marquee-group li::after { content:''; width:3px; height:3px; background:var(--subtle); }
  [data-offscreen='true'] .marquee-track, [data-hidden='true'] .marquee-track { animation-play-state:paused; }
  @media (hover:hover) { .interest-marquee:hover .marquee-track { animation-play-state:paused; } }
  @keyframes interests-scroll { to { transform:translateX(-50%); } }
  @media (prefers-reduced-motion:reduce), (scripting:none) {
    .marquee-window { overflow:visible; mask-image:none; }
    .marquee-track { display:block; width:auto; animation:none; }
    .marquee-group { flex-wrap:wrap; gap:12px 24px; padding:12px 0; }
    .marquee-group li { gap:24px; }
    .marquee-group[aria-hidden='true'], .marquee-group .repeat { display:none; }
  }
</style>
