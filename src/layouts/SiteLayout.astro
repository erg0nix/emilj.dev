---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'emilj.dev',
  description = "Emil's personal website. Projects, notes, and other things.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-season="autumn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const seasons = ['winter', 'spring', 'summer', 'autumn'];
        let theme = 'dark';
        let seasonChoice = 'auto';
        try {
          const savedTheme = localStorage.getItem('theme');
          const savedSeason = localStorage.getItem('season');
          if (['light', 'dark'].includes(savedTheme)) theme = savedTheme;
          if (seasons.includes(savedSeason)) seasonChoice = savedSeason;
        } catch {
          // Defaults remain available when storage is blocked.
        }

        function updateTheme() {
          root.dataset.theme = theme;
          const button = document.getElementById('theme');
          if (button) {
            button.setAttribute('aria-checked', String(theme === 'dark'));
            button.title = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
          }
          document.dispatchEvent(new Event('themechange'));
        }

        function updateSeason() {
          const month = new Date().getMonth();
          root.dataset.season = seasonChoice === 'auto'
            ? seasons[Math.floor(((month + 1) % 12) / 3)]
            : seasonChoice;

          const summary = document.querySelector('.season-picker summary');
          if (summary) {
            for (const button of document.querySelectorAll('[data-season-choice]')) {
              const selected = button.dataset.seasonChoice === seasonChoice;
              button.setAttribute('aria-pressed', String(selected));
              if (selected) {
                summary.replaceChildren(button.querySelector('svg').cloneNode(true));
                const label = 'Season: ' + button.getAttribute('aria-label');
                summary.setAttribute('aria-label', label);
                summary.title = label;
              }
            }
          }
          document.dispatchEvent(new Event('seasonchange'));
        }

        updateTheme();
        updateSeason();

        document.addEventListener('DOMContentLoaded', () => {
          const themeButton = document.getElementById('theme');
          const picker = document.querySelector('.season-picker');
          const summary = picker.querySelector('summary');
          updateTheme();
          updateSeason();
          themeButton.hidden = false;
          picker.hidden = false;

          themeButton.addEventListener('click', () => {
            theme = theme === 'dark' ? 'light' : 'dark';
            updateTheme();
            try {
              localStorage.setItem('theme', theme);
            } catch {
              // The current page still reflects the selection.
            }
          });

          for (const button of picker.querySelectorAll('[data-season-choice]')) {
            button.addEventListener('click', () => {
              seasonChoice = button.dataset.seasonChoice;
              updateSeason();
              picker.open = false;
              summary.focus();
              try {
                if (seasonChoice === 'auto') localStorage.removeItem('season');
                else localStorage.setItem('season', seasonChoice);
              } catch {
                // The current page still reflects the selection.
              }
            });
          }

          document.addEventListener('pointerdown', event => {
            if (!picker.contains(event.target)) picker.open = false;
          });
          picker.addEventListener('keydown', event => {
            if (event.key === 'Escape') {
              picker.open = false;
              summary.focus();
            }
          });
          picker.addEventListener('focusout', event => {
            if (!picker.contains(event.relatedTarget)) picker.open = false;
          });
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden && seasonChoice === 'auto') updateSeason();
          });
        });
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main"><slot /></main>
  </body>
</html>

<style is:global>
  :root { color-scheme:dark; --bg:#090b0d; --surface:#101315; --raised:#171b1e; --text:#eceeef; --muted:#979fa6; --subtle:#768087; --line:#23292d; --fine:#1a2024; --accent:#e79c60; --art:225,140,73; }
  :root[data-theme='light'] { color-scheme:light; --bg:#e8e7e2; --surface:#dfe1da; --raised:#efeee8; --text:#20292d; --muted:#56646d; --subtle:#64717a; --line:#c9cfc9; --fine:#d7dad2; --accent:#99501b; --art:165,91,37; }
  :root[data-season='winter'] { --accent:#9cc9e5; --art:139,192,224; }
  :root[data-season='spring'] { --accent:#dba7bc; --art:212,158,182; }
  :root[data-season='summer'] { --accent:#dbc37e; --art:213,184,105; }
  :root[data-season='winter'][data-theme='light'] { --accent:#28628b; --art:50,106,143; }
  :root[data-season='spring'][data-theme='light'] { --accent:#954164; --art:145,76,109; }
  :root[data-season='summer'][data-theme='light'] { --accent:#796019; --art:130,105,42; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; scroll-padding-top:32px; }
  body { margin:0; background:var(--bg); color:var(--text); font:14px/1.6 Arial,Helvetica,sans-serif; -webkit-font-smoothing:antialiased; }
  a { color:var(--accent); text-decoration-color:currentColor; text-underline-offset:5px; }
  a:hover { text-decoration-thickness:2px; }
  button, select { font:inherit; color:inherit; }
  button, select, a { -webkit-tap-highlight-color:transparent; }
  button, select { cursor:pointer; }
  button { background:none; border:0; }
  :focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  ::selection { color:var(--bg); background:var(--accent); }
  [hidden] { display:none!important; }
  .page-width { width:min(1200px, calc(100% - 96px)); margin-inline:auto; }
  .skip-link:not(:focus) { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  .skip-link:focus { position:fixed; top:12px; left:12px; padding:12px; background:var(--bg); z-index:10; }

  @media (min-width:1600px) { .page-width { width:1280px; } }
  @media (max-width:1100px) { .page-width { width:calc(100% - 64px); } }
  @media (max-width:760px) { .page-width { width:calc(100% - 40px); } }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
</style>
