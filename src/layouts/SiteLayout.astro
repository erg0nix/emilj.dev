---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'emilj.dev',
  description = "Emil's personal website. Projects, notes, and other things.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = 'dark';
        try {
          const savedTheme = localStorage.getItem('theme');
          if (['light', 'dark'].includes(savedTheme)) theme = savedTheme;
        } catch {
          // Defaults remain available when storage is blocked.
        }

        function updateTheme() {
          root.dataset.theme = theme;
          const button = document.getElementById('theme');
          if (button) {
            button.setAttribute('aria-checked', String(theme === 'dark'));
            button.title = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
          }
          document.dispatchEvent(new Event('themechange'));
        }

        updateTheme();

        document.addEventListener('DOMContentLoaded', () => {
          const themeButton = document.getElementById('theme');
          updateTheme();
          themeButton.hidden = false;

          themeButton.addEventListener('click', () => {
            theme = theme === 'dark' ? 'light' : 'dark';
            updateTheme();
            try {
              localStorage.setItem('theme', theme);
            } catch {
              // The current page still reflects the selection.
            }
          });
        });
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main"><slot /></main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --canvas: #090c0d;
    --bg: #101415;
    --surface: #1a2022;
    --raised: #232a2c;
    --text: #eceeef;
    --muted: #aeb6b9;
    --subtle: #8e999e;
    --line: #394246;
    --fine: #242c2f;
    --yellow: #f1db4b;
    --yellow-hover: #f9e878;
    --on-yellow: #17180e;
    --accent: var(--yellow);
    --art: 241,219,75;
  }
  :root[data-theme='light'] {
    color-scheme: light;
    --canvas: #dcded7;
    --bg: #e8e9e2;
    --surface: #dce0d8;
    --raised: #eff0e9;
    --text: #20292d;
    --muted: #536169;
    --subtle: #5b686e;
    --line: #aeb8b2;
    --fine: #d0d7cf;
    --accent: #756000;
    --art: 117,96,0;
  }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; scroll-padding-top:32px; }
  body { margin:0; background:var(--canvas); color:var(--text); font:14px/1.6 Arial,Helvetica,sans-serif; -webkit-font-smoothing:antialiased; }
  a { color:var(--accent); text-decoration-color:currentColor; text-underline-offset:5px; }
  a:hover { text-decoration-thickness:2px; }
  button, select { font:inherit; color:inherit; }
  button, select, a { -webkit-tap-highlight-color:transparent; }
  button, select { cursor:pointer; }
  button { background:none; border:0; }
  :focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  ::selection { color:var(--bg); background:var(--accent); }
  [hidden] { display:none!important; }
  .skip-link:not(:focus) { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  .skip-link:focus { position:fixed; top:12px; left:12px; padding:12px; background:var(--bg); z-index:10; }

  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
</style>
