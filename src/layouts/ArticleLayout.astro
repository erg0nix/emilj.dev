---
import SiteLayout from './SiteLayout.astro';
import PageFrame from '../components/PageFrame.astro';

interface Props {
  title: string;
  summary: string;
  backHref: string;
  backLabel: string;
}
const { title, summary, backHref, backLabel } = Astro.props;
---

<SiteLayout title={`${title} · emilj.dev`} description={summary}>
  <PageFrame>
    <article class="article" aria-labelledby="article-title">
      <header class="article-heading">
        <div class="article-context">
          <a class="back-link" href={backHref}>{backLabel}</a>
          {Astro.slots.has('meta') && <p class="article-meta"><slot name="meta" /></p>}
        </div>
        <div class="article-introduction">
          <h1 id="article-title">{title}</h1>
          <p class="summary">{summary}</p>
        </div>
      </header>
      <div class="article-reading">
        <div class="article-body"><slot /></div>
      </div>
      <div class="article-return">
        <a class="back-link" href={backHref}>{backLabel}</a>
      </div>
    </article>
  </PageFrame>
</SiteLayout>

<style>
  .article-heading {
    display: grid;
    grid-template-columns: var(--section-label) minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .article-context { padding: 32px 40px; }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .back-link:hover { text-decoration: underline; }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 12px 0 0;
    color: var(--subtle);
  }

  .article-introduction {
    min-width: 0;
    padding: 40px;
    border-left: 1px solid var(--line);
  }

  h1 {
    margin: 0 0 16px;
    color: var(--accent);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
  }

  .summary { max-width: 60ch; margin: 0; color: var(--muted); }

  .article-reading,
  .article-return {
    margin-left: var(--section-label);
    padding: 40px;
    border-left: 1px solid var(--line);
  }

  .article-body { max-width: 680px; line-height: 1.8; }

  .article-body :global(h2) {
    margin: 0 0 24px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -.02em;
  }

  .article-body :global(p) { margin: 0 0 24px; color: var(--muted); }
  .article-body :global(p:last-child) { margin-bottom: 0; }
  .article-return { padding-block: 16px; border-top: 1px solid var(--line); }

  @media (max-width: 760px) {
    .article-heading { grid-template-columns: minmax(0, 1fr); }
    .article-context { padding: 16px 24px; border-bottom: 1px solid var(--line); }
    .article-meta { margin-top: 4px; }
    .article-introduction { padding: 28px 24px; border-left: 0; }
    .article-reading, .article-return { margin-left: 0; padding-inline: 24px; border-left: 0; }
    .article-reading { padding-block: 28px; }
  }
</style>
